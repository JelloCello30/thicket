# ─────────────────────────────────────────────────────────────────────────────
# Thicket environment configuration
#
# Copy to .env.local inside apps/web for development. Every variable is
# optional in dev — each absence degrades one specific feature, honestly:
# no fake checkouts, no pretend AI.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Managed Postgres with the pgvector extension
# (Neon, Supabase, and RDS all support it; migrations create the extension).
# Absent in dev → PGlite (real Postgres compiled to WASM) at .pglite/ —
# zero setup, and `pnpm db:seed` fills it with realistic demo data.
DATABASE_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# REQUIRED IN PRODUCTION. The canonical origin, e.g. https://jellocello30.github.io/thicket
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (console.cloud.google.com → OAuth consent + credentials;
# authorized redirect: <origin>/api/auth/callback/google).
# Absent → the Google button is hidden; magic-link login still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link delivery via Resend (resend.com). Absent in dev → the link is
# printed to the server console, so login still works end-to-end.
RESEND_API_KEY=
EMAIL_FROM="Thicket <login@jellocello30.github.io/thicket>"

# ── AI ──────────────────────────────────────────────────────────────────────
# Anthropic API key (console.anthropic.com). Absent → the extension's local
# organization still works fully; AI endpoints return 503 "ai-unavailable".
ANTHROPIC_API_KEY=
# Voyage AI key (voyageai.com) for semantic-search embeddings.
# Absent → search is lexical only.
VOYAGE_API_KEY=
# Optional model overrides (defaults: fast=claude-haiku-4-5, smart=claude-opus-5).
AI_MODEL_FAST=
AI_MODEL_SMART=

# ── Billing (Stripe) ────────────────────────────────────────────────────────
# dashboard.stripe.com → create two recurring Prices for the Pro product
# ($8/month, $72/year) and a webhook endpoint at <origin>/api/stripe/webhook
# subscribed to: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
# Absent → pricing page shows plans; upgrade reports billing isn't configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ── Observability (all optional) ────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# First-party analytics always write to your own events table; set these to
# additionally forward to PostHog.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Extension ───────────────────────────────────────────────────────────────
# Comma-separated Chrome extension IDs allowed to link devices (CORS + the
# connect page's messaging). Set after your first Chrome Web Store upload;
# in development any chrome-extension:// origin is accepted.
THICKET_EXTENSION_IDS=

# Protects /api/cron/retention (Vercel Cron sends it automatically).
CRON_SECRET=
